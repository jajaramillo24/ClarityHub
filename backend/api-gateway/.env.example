PORT=3000
IDEA_BOARD_SERVICE_URL=http://localhost:3001
REQUIREMENT_REFINER_SERVICE_URL=http://localhost:3002
STRUCTURE_SERVICE_URL=http://localhost:3003
JIRA_EXPORTER_SERVICE_URL=http://localhost:3004
RABBITMQ_URL=amqp://guest:guest@localhost:5672
DATABASE_URL=mysql://root:root@localhost:3306/auth?allowPublicKeyRetrieval=true
# Signs/verifies the JWTs issued by POST /auth/login. Change this to a long
# random value outside local dev.
JWT_SECRET=dev-secret-change-me
# Comma-separated list of origins allowed by CORS — this is the one that
# actually matters, since api-gateway is the only service a browser talks
# to directly. Defaults to the local Vite dev server if unset; set this to
# the deployed frontend's origin (e.g. https://<user>.github.io) in
# production, see DEPLOY.md.
CORS_ORIGIN=http://localhost:5173
