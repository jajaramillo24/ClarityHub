generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Idea {
  id        String   @id @default(uuid())
  // The id of the api-gateway project this idea belongs to (see
  // api-gateway's `projects` table) — not a local foreign key, since that
  // table lives in a different service's database. Forwarded on every
  // request as the X-Project-Id header (ProxyService in api-gateway,
  // ProjectGuard here); api-gateway already checked it belongs to the
  // caller before ever proxying the request.
  projectId String   @map("project_id") @db.VarChar(36)
  content   String   @db.Text
  category  String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("ideas")
}

model Attachment {
  id        String   @id @default(uuid())
  projectId String   @map("project_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  mimeType  String   @map("mime_type") @db.VarChar(150)
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("attachments")
}
