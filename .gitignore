# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Backend services pin exact dependency versions in package.json itself
# (see e.g. backend/idea-board-service's @nestjs/typeorm/typeorm pins), so
# lockfiles aren't required for reproducible installs here. Excluded to
# keep pushes to the GitHub API-based remote (this session's git push over
# the git protocol is blocked by org policy) from having to embed huge
# generated JSON blobs on every service.
backend/*/package-lock.json

# Environment variables
.env
.env.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
