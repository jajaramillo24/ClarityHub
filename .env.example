# ClarityHub frontend — variables de entorno

# api-gateway base URL. El frontend nunca habla con un proveedor de IA ni
# con ningún otro servicio del backend directamente — todo pasa por el
# gateway. El backend vive en su propio repositorio (clarityhub-backend);
# levantalo con `docker compose up` ahí y esta URL ya apunta bien.
VITE_API_URL=http://localhost:3000
