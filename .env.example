# ClarityHub Environment Variables

# api-gateway base URL. The frontend never talks to an AI provider or any
# other backend service directly — everything goes through the gateway.
VITE_API_URL=http://localhost:3000

# Only needed to run the full backend via `docker compose up` (docker-compose.yml
# reads this file too). Used by requirement-refiner-service to call Claude.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Signs the JWTs api-gateway issues on login. docker-compose.yml falls back
# to a dev value if this is unset, but set a real random value before
# showing this with real data or exposing it outside localhost.
JWT_SECRET=your-long-random-secret-here
